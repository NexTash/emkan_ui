    "css": ".highlight{\n    text-align:center;\n    padding: 5px 50px;\n    text-align: center;\n    background-color: #c0c0c0;\n    border-radius: 10px;\n    color:black;\n}\n.header{\n    display:flex;\n    width:100%;\n    gap:40px;\n}\n.footer{\n    display:flex;\n    position:fixed;\n    width:100%;\n}\nimg {\n    vertical-align: middle;\n    height: 112%;\n    width: 100%;\n}\n.print-format img {\n    max-width: 100%;\n    max-height: 100%;\n}\nh4{\n    font-size: 25px;\n}\nh2{\n    font-size: 16px;\n    font-weight:bold;\n    color:black;\n}\n.main-table th { \n    background-color: #d3d3d3;\n    color: black; \n    text-align: left;\n}\n.footer{\n    position:absolute;\n    bottom:0;\n    max-width:100%;\n    max-height:100%;\n}\n.footer1 {\n    display: flex;\n    justify-content: space-between;\n    width: 80%;\n    margin: 40px auto;\n}\n\n.signature {\n    width: 30%;\n    text-align: center;\n    position: relative;\n}\n\n.signature::before {\n    content: '';\n    position: absolute;\n    top: -10px;\n    left: 0;\n    width: 100%;\n    height: 2px;\n    background-color: black;\n}",
