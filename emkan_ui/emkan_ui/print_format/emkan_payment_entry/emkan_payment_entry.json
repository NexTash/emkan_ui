    "doctype": "Print Format",
    "font_size": 14,
    "html": "<table style=\"width:100%;\">\n    <thead style=\"width:100%;border-bottom: 1.5px dotted #c0c0c0;\">\n        <tr>\n            <th>\n                \n      <header class=\"header\">\n         <div class=\"logo\" style=\"width:100%;\">\n            <img src=\"/assets/emkan_ui/images/EMKAN.jpg\">\n        </div>\n       </header>\n                <div class=\"header-text\">\n            <div class=\"highlight\" style=\"margin-top: 13px;\">\n                <h4 style=\"margin:0px; text-align: center;\">PAYMENT ENTRY:  {{ doc.name }}</h4>\n            </div>\n            </th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <th>\n          <div class=\"sm-text\" style=\"display:flex;border-bottom: 1.5px dotted #c0c0c0;width:100%; font-size:15px\">\n    <div style=\"margin-bottom: 1%; color: black\">\n        <b>Party Name:</b>{{ doc.party_name }}<br><br>\n        <b>Cost Center/Division:</b>{{ doc.custom_department }}<br><br>\n        <b>Party ID:</b>{{ doc.party }}<br><br>\n        \n        <b>Paid From Account Type:</b>\n    </div>\n    <div style=\"color: black;margin-left:50px;margin-bottom: 1%;\n\">\n        <b>Date:</b>{{ doc.posting_date }}<br><br>\n        <b>Mode of Payment:</b>{{ doc.mode_of_payment }}<br><br>\n        <b>Advance Payment:</b><span style=\"color:blue;\">\n            {% if doc.custom_advance_payment or \"\"%}\n            &#10003;\n        {% endif %}\n        </span><br><br>\n        <b>Paid To Account Type:</b>{{doc.payment_type}}\n    </div>\n</div>\n<br>\n    \n    <table class=\"main-table\" style=\"width:100%; border-spacing: 0 5px; border-collapse: separate; font-size:13px;\">\n        \n        {% if doc.references | length < 1 %}\n                        <tr>\n                            <th class=\"center c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">Description</th>\n                            <th class=\"center c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">Amount (QAR)</th>\n                        </tr>\n                        <tr>\n                            <td class=\"center c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">{{doc.remarks}}</td>\n                            <td class=\"center c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">{{doc.get_formatted('paid_amount')}}</td>\n                        </tr>\n                {% else %}\n      <tr>\n            <th class=\"center c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">SR</th>\n            <th class=\"text-left c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">Type</th>\n            <th class=\"text-left c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">Name</th>\n            <th class=\"text-right c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">Outstanding</th>\n            <th class=\"text-right c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">Allocated</th>\n            <th class=\"text-right c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">Exchange Gain/Loss</th>\n            <th class=\"text-right c-black\" style=\"padding-top:0px !important;color: black; font-weight:bold\">Account</th>\n      </tr>\n      <tr>\n        {% for row in doc.references %}\n            <td class=\"center\">{{row.idx}}</td> \n            <td class=\"text-left\">{{row.reference_doctype}}</td>\n            <td class=\"text-left\">{{row.reference_name}}</td>\n            <td class=\"center\">{{row.get_formatted(\"outstanding_amount\")}}</td>\n            <td class=\"center\">{{row.get_formatted(\"allocated_amount\")}}</td>\n            <td class=\"center\">{{row.get_formatted(\"exchange_rate\")}}</td>\n            <td class=\"center\">{{row.account}}</td>\n      </tr>\n        {% endfor%}\n        {% endif%}\n    </table>\n        <tr>\n            <td>\n         <div class=\"sm-text\" style=\"display:flex;border-top: 1.5px dotted #c0c0c0;width:100%; font-size:15px\">\n            <div style=\"margin-bottom: 1%; color: black\">\n               <br><b>Check No:</b>{{doc.reference_no or \"\"}}<br><br>\n               <b>Remarks:</b>{{doc.remarks}}\n            </div>\n        </div>\n                    </td>\n        </tr>\n    </tbody>\n    <tfoot style=\"width:100%;border-bottom: 1.5px dotted #c0c0c0;\">\n        <tr>\n      <footer class=\"footer\">\n         <div class=\"logo\" style=\"width:100%;\">\n            <img src=\"/assets/emkan_ui/images/emkan-footer.png\">\n        </div>\n       </footer>\n        </tr>\n    </tfoot>\n    <tr>\n            <td>\n            <div class=\"footer1\">\n                <div class=\"signature\">PREPARED BY</div>\n                <div class=\"signature\">RECEIVED BY</div>\n            </div>\n            </td>\n        </tr>\n        \n</table>",
