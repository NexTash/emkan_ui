 "html": "<div style=\"font-family: Arial, sans-serif; font-size: 12px;\">\n<table style=\"width:100%; border-collapse:collapse; font-size:12px;\">\n  <tr>\n    <td colspan=\"3\"\n        style=\"background:#0a2cd5; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000;padding: 10px !important;\">\n      {{ doc.company or \"EMKAN ENGINEERING\" }}\n    </td>\n  </tr>\n  <tr>\n    <td rowspan=\"2\"\n        style=\"width:15%; border:1px solid #000; height:80px; text-align:center; vertical-align:middle; padding:0;\">\n      <img src=\"/files/Screenshot from 2025-08-18 14-53-33.png\">\n    </td>\n   <td\n        style=\"border:1px solid #000; text-align:center; font-size:16px; font-weight:bold; padding:6px; vertical-align:middle;\">\n      Advance Payment Request Form\n    </td>\n        <td style=\"width:20%; border:1px solid #000; padding:0; vertical-align:top;\">\n          <table style=\"width:100%; height:80px; border-collapse:collapse;\">\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n          </table>\n        </td>\n  </tr>\n</table>\n    <br><br>\n    <table style=\"width: 100%; font-size: 12px;\">\n        <tr>\n            <td><strong>DATE:</strong> {{ frappe.utils.formatdate(doc.transaction_date, \"dd-MM-yyyy\") }}</td>\n            <td style=\"text-align: right;\"><strong>Request No:</strong> {{ doc.name or \"\" }}</td>\n        </tr>\n       <tr>\n            <td><strong>Division: </strong> {{doc.custom_department}}</td>\n            <td style=\"text-align: right;\"><strong>Payment Type: </strong> {{doc.payment_request_type or \"\"}}</td>\n       </tr>\n    </table>\n    <br>\n   <table style=\"width: 100%; font-size: 12px;\">\n      <tr>\n        <td>\n          <strong>SUPPLIER: </strong>\n          {% if doc.party_type == \"Supplier\" %}\n            {% set supp_name = frappe.db.get_value(\"Supplier\", doc.party, \"supplier_name\") %}\n            {% if supp_name %}\n              <strong>{{ supp_name }}</strong>\n            {% else %}\n              {{ doc.party or \"\" }}\n            {% endif %}\n          {% else %}\n            {% if doc.supplier_name %}\n              <strong>{{ doc.supplier_name }}</strong>\n            {% else %}\n              {{ doc.supplier or \"\" }}\n            {% endif %}\n          {% endif %}\n        </td>\n\n    </tr>\n\n  {% if doc.reference_name %}\n  <!--<tr>-->\n  <!--  <td><strong>Payment Entry: </strong> {{ doc.reference_name }}</td>-->\n  <!--</tr>-->\n  {% endif %}\n</table>\n    <br>\n        <table style=\"width:100%; border:1px solid #000; border-collapse:collapse; font-size:12px;\">\n          <thead>\n            <tr style=\"background:#f0f0f0;\">\n              <th style=\"border:1px solid #000; padding:10px; width:25%\"><b>Purchase reference</b></th>\n              <th style=\"border:1px solid #000; padding:10px; width:50%\"><b>Remarks</b></th>\n              <th style=\"border:1px solid #000; padding:10px; width:25%\"><b>Amount</b></th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td style=\"border:1px solid #000; padding:8px;\">{{ doc.reference_name or \"\" }}</td>\n              <td style=\"border:1px solid #000; padding:8px;\">{{ doc.message or \"\" }}</td>\n              <td style=\"border:1px solid #000; padding:8px; text-align:left;\">\n                {{ doc.get_formatted(\"grand_total\") or doc.grand_total or \"\" }}\n              </td>\n            </tr>\n          </tbody>\n        </table>\n    <br>\n\n    <!--<div style=\"text-align: left; font-size: 12px;\">-->\n    <!--    <em>(* Supportings attached for more reference)</em>-->\n    <!--</div>-->\n    <!--<br>-->\n    <table style=\"width: 100%; font-size: 12px;\">\n        <tr>\n            <td style=\"text-align: right;\"><strong>TOTAL</strong></td>\n            <td style=\"text-align: right; width: 120px;\"><strong>{{ doc.get_formatted(\"grand_total\") }} {{ doc.currency or \"\" }}</strong></td>\n        </tr>\n        <!--<tr>-->\n        <!--    <td style=\"border: 1px solid black;\"><strong>Remarks: </strong> {{doc.remarks}} </td>-->\n            \n        <!--</tr>-->\n    </table>\n    <br><br>\n    <br><br>\n    <br><br>\n<table style=\"width: 100%; font-size: 10px; text-align: center; border-collapse: collapse;\" border=\"1\">\n    <tr>\n        <td style=\"width:15%;\"><b>PREPARED BY</b></td>\n        <td style=\"width:35%;\" colspan=\"3\"><b>VERIFIED BY</b></td>\n        <td style=\"width:25%;\" colspan=\"2\"><b>RECOMMENDED BY</b></td>\n    </tr>\n    <tr>\n        <td>AKP<br>(ASST. ACCOUNTANT)</td>\n        <td>AKS<br>(SR. ACCOUNTANT)</td>\n        <td>JKA<br>(LEAD ACCOUNTANT)</td>\n        <td>RK<br>(MANAGER - ACCOUNTS)</td>\n        <td>BDN<br>(DIRECTOR - FINANCE)</td>\n        <td>MTS<br>(CHIEF OPERATING OFFICER)</td>\n    </tr>\n    <tr>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n    </tr>\n</table>\n<table style=\"width: 100%; font-size: 10px; text-align: center;\" border=\"1\" >\n    <tr>\n        <h5 class=\"c1\"  style=\"text-align: center;padding:0px !important;\" > <b>APPROVED BY</b></h5>\n    </tr>\n    <tr>\n        <td style=\"width:50%;\"><b>SB</b><br></td>\n        \n        <td style=\"width:50%%;\"><b>JMA</b><br></td>\n    </tr>\n    <tr>\n    <td style=\"height:150px;\">(MANAGING DIRECTOR & CEO)</td>\n    <td style=\"height:150px;\">(EMKAN HOLDING)</td>\n    </tr>\n</table>\n</div>",
