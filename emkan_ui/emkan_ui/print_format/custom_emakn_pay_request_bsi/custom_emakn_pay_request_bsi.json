 "font_size": 14,
 "html": "<div style=\"font-family: Arial, sans-serif; font-size: 12px;\">\n\n<table style=\"width:100%; border-collapse:collapse; font-size:12px;\">\n  <!-- Top blue bar -->\n  <tr>\n  {% if doc.division == \"EMKAN-1\" %}\n    <td colspan=\"3\"\n        style=\"background:#0a2cd5; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000; padding: 10px !important;\">\n      {{ doc.company or \"EMKAN ENGINEERING\" }}\n    </td>\n  {% elif doc.division == \"EMKAN-2\" %}\n    <td colspan=\"3\"\n        style=\"background:#1172BC; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000; padding: 10px !important;\">\n      {{ doc.company or \"EMKAN ENGINEERING\" }}\n    </td>\n  {% elif doc.division == \"EMKAN-3 (SSSF)\" %}\n    <td colspan=\"3\"\n        style=\"background:#3B7D23; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000; padding: 10px !important;\">\n      {{ doc.company or \"SSSF\" }}\n    </td>\n  {% elif doc.division == \"EMKAN-4 (BSI)\" %}\n    <td colspan=\"3\"\n        style=\"background:#FF8C00; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000; padding: 10px !important;\">\n      {{ doc.company or \"BSI\" }}\n    </td>\n  {% elif doc.division == \"EMKAN-5\" %}\n    <td colspan=\"3\"\n        style=\"background:#78206E; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000; padding: 10px !important;\">\n      {{ doc.company or \"EMKAN ENGINEERING\" }}\n    </td>\n  {% elif doc.division == \"EMKAN-6 ( Cantech )\" %}\n    <td colspan=\"3\"\n        style=\"background:#1172BC; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000; padding: 10px !important;\">\n      {{ doc.company or \"CANTECH SOLUTION W.L.L\" }}\n    </td>\n  {% elif doc.division == \"EMK-ADMIN & PROJECT COMMON\" %}\n    <td colspan=\"3\"\n        style=\"background:#1172BC; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000; padding: 10px !important;\">\n      {{ doc.company or \"ADMIN & PROJECT COMMON\" }}\n    </td>\n  {% else %}\n    <td colspan=\"3\"\n        style=\"background:#1172BC; color:#ffffff; text-align:center; font-weight:bold;\n               border:1px solid #000; padding: 10px !important;\">\n      {{ doc.company or \"EMKAN ENGINEERING\" }}\n    </td>\n  {% endif %}\n</tr>\n\n  <!-- Logo | Title | Right small grid -->\n  <tr>\n    <!-- Left: logo placeholder -->\n    <td rowspan=\"2\"\n        style=\"width:15%; border:1px solid #000; height:80px; text-align:center; vertical-align:middle; padding:0;\">\n      <!-- Yahan aap apna <img src=\"...\"> daal lena -->\n      <img src=\"/files/Screenshot from 2025-08-18 14-53-33.png\">\n    </td>\n\n    <!-- Center: title -->\n   <td\n        style=\"border:1px solid #000; text-align:center; font-size:16px; font-weight:bold; padding:6px; vertical-align:middle;\">\n      Advance Payment Request Form\n    </td>\n\n    <!-- Right: 3-cell grid (same row me hi) -->\n        <td style=\"width:20%; border:1px solid #000; padding:0; vertical-align:top;\">\n          <table style=\"width:100%; height:80px; border-collapse:collapse;\">\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <!--<tr><td style=\"height:16px;\"></td></tr>-->\n          </table>\n        </td>\n\n  </tr>\n</table>\n    <br><br>\n\n    <!-- Date & Request No -->\n    <table style=\"width: 100%; font-size: 12px;\">\n        <tr>\n            <td><strong>DATE:</strong> {{ frappe.utils.formatdate(doc.transaction_date, \"dd-MM-yyyy\") }}</td>\n\n            <td style=\"text-align: right;\"><strong>Request No:</strong> {{ doc.name or \"\" }}</td>\n        </tr>\n       <tr>\n            <td><strong>Devision: </strong> {{doc.division}}</td>\n            <td style=\"text-align: right;\"><strong>Payment Type: </strong> {{doc.payment_request_type or \"\"}}</td>\n       </tr>\n    </table>\n    <br>\n\n    <!-- Supplier -->\n   <table style=\"width: 100%; font-size: 12px;\">\n      <tr>\n          <td>\n            <strong>SUPPLIER: </strong>\n            {% if doc.party_type == \"Supplier\" %}\n              {{ frappe.db.get_value(\"Supplier\", doc.party, \"supplier_name\") or doc.party or \"\" }}\n            {% else %}\n              {{ doc.supplier_name or doc.supplier or \"\" }}\n            {% endif %}\n          </td>\n    </tr>\n\n  {% if doc.reference_name %}\n  <tr>\n    <td><strong>Payment Entry: </strong> {{ doc.reference_name }}</td>\n  </tr>\n  {% endif %}\n</table>\n\n\n    <br>\n\n    <!-- Invoice Table -->\n        <table style=\"width:100%; border:1px solid #000; border-collapse:collapse; font-size:12px;\">\n          <thead>\n            <tr style=\"background:#f0f0f0;\">\n              <th style=\"border:1px solid #000; padding:10px; width:25%\"><b>Purchase reference</b></th>\n              <th style=\"border:1px solid #000; padding:10px; width:50%\"><b>Remarks</b></th>\n              <th style=\"border:1px solid #000; padding:10px; width:25%\"><b>Amount</b></th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td style=\"border:1px solid #000; padding:8px;\">{{ doc.reference_name or \"\" }}</td>\n              <td style=\"border:1px solid #000; padding:8px;\">{{ doc.message or \"\" }}</td>\n              <td style=\"border:1px solid #000; padding:8px; text-align:left;\">\n                {{ doc.get_formatted(\"grand_total\") or doc.grand_total or \"\" }}\n              </td>\n            </tr>\n          </tbody>\n        </table>\n\n\n\n    <br>\n\n    <!--<div style=\"text-align: left; font-size: 12px;\">-->\n    <!--    <em>(* Supportings attached for more reference)</em>-->\n    <!--</div>-->\n    <!--<br>-->\n\n    <!-- Total -->\n    <table style=\"width: 100%; font-size: 12px;\">\n        <tr>\n            <td style=\"text-align: right;\"><strong>TOTAL</strong></td>\n            <td style=\"text-align: right; width: 120px;\"><strong>{{ doc.get_formatted(\"grand_total\") }} {{ doc.currency or \"\" }}</strong></td>\n        </tr>\n        <!--<tr>-->\n        <!--    <td style=\"border: 1px solid black;\"><strong>Remarks: </strong> {{doc.remarks}} </td>-->\n            \n        <!--</tr>-->\n    </table>\n    <br><br>\n    <br>\n    <!--<br><br>-->\n<!--Signatures -->\n<table style=\"width: 100%; font-size: 10px; text-align: center; border-collapse: collapse;\" border=\"1\">\n    <tr>\n        <td style=\"width:15%;\"><b>PREPARED BY</b></td>\n        <td style=\"width:35%;\" colspan=\"3\"><b>VERIFIED BY</b></td>\n        <td style=\"width:25%;\" colspan=\"3\"><b>RECOMMENDED BY</b></td>\n    </tr>\n    <tr>\n        <td>AKP<br>(ASST. ACCOUNTANT)</td>\n        <td>MR<br>(LEAD. ACCOUNTANT)</td>\n        <td>AKS<br>(SR. ACCOUNTANT)</td>\n        <td>JKA<br>(LEAD ACCOUNTANT)</td>\n        <td>RK<br>(MANAGER - ACCOUNTS)</td>\n        <td>BDN<br>(DIRECTOR - FINANCE)</td>\n        <td>MTS<br>(CHIEF OPERATING OFFICER)</td>\n    </tr>\n    <tr>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n        <td style=\"height:120px; vertical-align:top;\"></td>\n    </tr>\n    \n</table>\n\n<!--Approval -->\n<table style=\"width: 100%; font-size: 10px; text-align: center;\" border=\"1\" >\n    <tr>\n        <h5 class=\"c1\"  style=\"text-align: center;padding:0px !important;\" > <b>APPROVED BY</b></h5>\n    </tr>\n    <tr>\n        <td style=\"width:25%\"><b>BN</b><br></td>\n        <td style=\"width:50%;\"><b>SB</b><br></td>\n        \n        <td style=\"width:25%%;\"><b>JMA</b><br></td>\n    </tr>\n    <tr>\n    <td style=\"height:120px;\">VICE-CHAIRMAN</td>\n    <td style=\"height:120px;\">(MANAGING DIRECTOR & CEO)</td>\n    <td style=\"height:120px;\">(EMKAN HOLDING)</td>\n    </tr>\n    \n</table>\n\n\n</div>\n",
