 "html": "  <div style=\"text-align: center; background-color: #007ACC; color: white; padding: 10px;\">\n      <td><h2>EMKAN ENGINEERING</h2></td>\n    <td>11TH FLOOR QATAR TOWER MAJLIS AL-TAAWON STREET WEST BAY P.O BOX 599 DOHA - STATE OF QATAR</td>\n  </div>\n  <div style=\"display: flex; justify-content: center; margin: 10px 0;\">\n    <table style=\"width: 100%; text-align: center;\">\n       <tr>\n    <td style=\"text-align: left; width:25%;\" colspan=\"1\">\n        <img src=\"/files/enkamlogo.png\" alt=\"Company Logo\" style=\"height: 70px;\">\n    </td>\n    <td style=\"font-weight: bold; width:50%;\" colspan=\"1\">\n        PAY SLIP - JANUARY 2025\n    </td>\n    <td rowspan=\"2\" style=\"width:25%;\">\n        <div style=\"border-bottom:1px solid black;\">{{ doc.posting_date or \"\" }}</div>\n        <div><b>Period:</b> {{ doc.start_date }} to {{ doc.end_date }}</div>\n    </td>\n</tr>\n    </table>\n</div>\n  <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\n      {% set employee_doc = frappe.get_doc(\"Employee\", doc.employee) %}\n    <tr>\n      <td>Emp Code:</td>\n      <td>{{ employee_doc.name or \"\" }}</td>\n      <td><b>Currency:</b></td>\n      <td><b>{{ doc.currency or \"\" }}</b></td>\n    </tr>\n    <tr>\n      <td>Name:</td>\n      <td>{{ employee_doc.employee_name or \"\" }}</td>\n      <td>Bank Name:</td>\n      <td>{{ employee_doc.custom_bank_name or \"\" }}</td>\n    </tr>\n    <tr>\n      <td>Designation:</td>\n      <td>{{ employee_doc.designation or \"\" }}</td>\n      <td>Bank Account No:</td>\n      <td>{{ employee_doc.custom_bank_no or \"\" }}</td>\n    </tr>\n    <tr>\n      <td>Department:</td>\n      <td>{{ employee_doc.department or \"\" }}</td>\n      <td>Location:</td>\n      <td>{{ doc.branch or \"\" }}</td>\n    </tr>\n    <tr>\n      <td>DOJ:</td>\n      <td>{{ employee_doc.date_of_joining or \"\" }}</td>\n      <td></td>\n      <td></td>\n    </tr>\n  </table>\n\n  <hr style=\"margin: 10px 0;\">\n  \n  <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;\">\n    <tr>\n      <td>Total Gross Salary:</td>\n      <td>{{ doc.net_pay or \"\" }}</td>\n      <td></td>\n      <td></td>\n    </tr>\n    <tr>\n      <td>NO of Working Days:</td>\n      <td>{{ doc.total_working_days or \"\" }}</td>\n      <td>Paid Leave:</td>\n      <td></td>\n    </tr>\n    <tr>\n      <td>R-OT.H:</td>\n      <td></td>\n      <td>Absent Days:</td>\n      <td>{{ doc.absent_days or \"\" }}</td>\n    </tr>\n    <tr>\n      <td>F-OT.H:</td>\n      <td></td>\n      <td>Medical Leave:</td>\n      <td></td>\n    </tr>\n  </table>\n\n  <hr style=\"margin: 10px 0;\">\n\n<div style=\"display:flex; gap:2px;\">\n<table style=\"width: 50%; border-collapse: collapse; font-size: 12px;\">\n    <thead>\n      <tr>\n        <td colspan=\"2\" style=\"text-align:center;\"><b>EARNINGS</b></td>\n      </tr>\n    </thead>\n    <tbody>\n          {%for earning in doc.earnings%}\n      <tr>\n        <td> {{ earning.salary_component }}</td>\n        <td>{{ earning.amount }}</td>\n        </tr>\n        {%endfor%}\n    </tbody>\n  </table>\n  <table style=\"width: 50%; border-collapse: collapse; font-size: 12px;\">\n    <thead>\n      <tr>\n        <td colspan=\"2\" style=\"text-align:center;\"><b>DEDUCTIONS</b></td>\n      </tr>\n    </thead>\n    <tbody>\n        {%for deduction in doc.deductions%}\n        <tr>\n        <td>\n          {{ deduction.salary_component }}</td>\n          <td>{{ deduction.amount }}</td>\n      </tr>\n        {%endfor%}\n    </tbody>\n  </table>\n  </div>\n\n  <hr style=\"margin: 10px 0;\">\n\n  <table style=\"width: 100%; font-size: 12px;\">\n    <tr>\n      <td><b>Total Earning</b></td>\n      <td>{{ doc.gross_pay or \"0.00\" }}</td>\n      <td><b>Total Deduction</b></td>\n      <td>{{ doc.total_deduction or \"0.00\" }}</td>\n    </tr>\n    <tr>\n      <td colspan=\"3\" style=\"text-align:center; font-size:bold;\"><b>Net Salary</b></td>\n      <td>{{ doc.net_pay or \"0.00\" }}</td>\n    </tr>\n  </table>\n\n  <hr style=\"margin: 10px 0;\">\n\n  <p style=\"font-size: 10px;\">\n    * Salary is calculated from {{ doc.start_date or \"\" }} to {{ doc.end_date or \"\" }}. <br>\n    * Any clarifications related to salary and benefits are to be discussed with HR. <br>\n    * All matters related to salary and benefits are strictly confidential.\n  </p>\n\n  <div style=\"margin-top: 20px;\">\n    <table style=\"width: 100%; border-collapse: collapse; font-size: 12px;text-align:center;\">\n      <tr>\n        <td><b>Employee Signature</b></td>\n\n        <td><b>Approved By</b></td>\n      </tr>\n      <tr>\n        <td>______________________</td>\n\n        <td>______________________</td>\n      </tr>\n    </table>\n  </div>\n",
