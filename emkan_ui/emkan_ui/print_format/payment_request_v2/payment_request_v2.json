 "doc_type": "Custom Payment Request",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<div class=\"page\">\n\n  <!-- PAGE HEADER -->\n  <div class=\"page-header\" style=\"margin:0; padding:0;\">\n    <table style=\"width:100%; border-collapse:collapse; font-size:12px; margin:0; padding:0;\">\n      <tr>\n        <td colspan=\"3\" style=\"background:#0a2cd5; color:#fff; text-align:center; font-weight:bold; border:1px solid #000; padding:0;\">\n          {{ doc.company or \"EMKAN ENGINEERING\" }}\n        </td>\n      </tr>\n      <tr>\n        <td rowspan=\"2\" style=\"width:15%; border:1px solid #000; text-align:center; vertical-align:middle; padding:0;\">\n          <img src=\"/files/Screenshot from 2025-08-18 14-53-33.png\" style=\"max-height:70px;\">\n        </td>\n        <td style=\"border:1px solid #000; text-align:center; font-size:16px; font-weight:bold; padding:0; vertical-align:middle;\">\n          PAYMENT REQUEST FORM ({{ doc.name }})\n        </td>\n        <td style=\"width:20%; border:1px solid #000; padding:0; vertical-align:top;\">\n          <table style=\"width:100%; height:80px; border-collapse:collapse; margin:0; padding:0;\">\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n            <tr><td style=\"border-bottom:1px solid #000; height:16px;\"></td></tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </div>\n\n  <!-- HEADER DETAILS -->\n  <div class=\"content\" style=\"margin:0; padding:0;\">\n    <table style=\"width: 100%; font-size: 12px; margin:0; padding:0;\">\n      <tr>\n        <td><strong>DATE:</strong> {{ frappe.utils.formatdate(doc.transaction_date, \"dd-MM-yyyy\") }}</td>\n        <td style=\"text-align:right;\"><strong>Request No:</strong> {{ doc.name or \"\" }}</td>\n      </tr>\n      <tr>\n        <td><strong>Division:</strong> {{ doc.division }}</td>\n        <td style=\"text-align:right;\"><strong>Payment Type:</strong> {{ doc.mode_of_payment or \"\" }}</td>\n      </tr>\n    </table>\n    <br>\n    <table style=\"width:100%; font-size:12px; margin:0; padding:0;\">\n      <tr>\n        <td>\n          <strong>SUPPLIER:</strong>\n          {% if doc.party_type == \"Supplier\" %}\n            {{ frappe.db.get_value(\"Supplier\", doc.party, \"supplier_name\") or doc.party or \"\" }}\n          {% else %}\n            {{ doc.supplier_name or doc.supplier or \"\" }}\n          {% endif %}\n        </td>\n      </tr>\n    </table>\n  </div>\n\n  <!-- FULL TABLE (all rows) -->\n  <table style=\"width:100%; border:1px solid #000; border-collapse:collapse; font-size:12px; margin:0; padding:0;\">\n    <thead>\n      <tr style=\"background:#f0f0f0;\">\n        <th style=\"border:1px solid #000; width:20%;\">Supplier Invoice</th>\n        <th style=\"border:1px solid #000; width:20%;\">Invoice Date</th>\n        <th style=\"border:1px solid #000; width:40%;\">Remarks</th>\n        <th style=\"border:1px solid #000; width:20%;\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {%- for row in doc.references | sort(attribute='custom_supplier_invoice_date', reverse=false) %}\n      <tr>\n        <td style=\"border:1px solid #000; padding:5px;\">{{ row.supplier_invoice_number or \"\" }}</td>\n        <td style=\"border:1px solid #000; padding:5px;\">\n          {{ frappe.utils.formatdate(row.custom_supplier_invoice_date, \"dd-MM-yyyy\") if row.custom_supplier_invoice_date else \"\" }}\n        </td>\n        <td style=\"border:1px solid #000; padding:5px;\">{{ row.remarks or \"\" }}</td>\n        <td style=\"border:1px solid #000; padding:5px;\">{{ row.get_formatted(\"amount\") }}</td>\n      </tr>\n      {%- endfor %}\n    </tbody>\n\n  </table>\n\n\n</div>\n\n<!-- TOTAL aur FOOTER -->\n<br>\n<table style=\"width: 100%; font-size: 12px;\">\n  <tr>\n    <td style=\"text-align: right;\"><strong>TOTAL</strong></td>\n    <td style=\"text-align: right; width: 120px;\">\n      <strong>{{ doc.get_formatted(\"grand_total\") }} {{ doc.currency or \"\" }}</strong>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"border: 1px solid black;\"><strong>Remarks: </strong> {{ doc.remarks or \"\"}} </td>\n  </tr>\n</table>\n<br><br>\n\n<!-- Signatures -->\n<table style=\"width: 100%; font-size: 10px; text-align: center; border-collapse: collapse;\" border=\"1\">\n  <tr>\n    <td><b>PREPARED BY</b></td>\n    <td colspan=\"3\"><b>VERIFIED BY</b></td>\n    <td colspan=\"3\"><b>RECOMMENDED BY</b></td>\n  </tr>\n  <tr>\n    <td><b>AKP</b><br>(ASST. ACCOUNTANT)</td>\n    <td><b>AKS</b><br>(SR. ACCOUNTANT)</td>\n    <td><b>JKA</b><br>(LEAD ACCOUNTANT)</td>\n    <td><b>RK</b><br>(MANAGER - ACCOUNTS)</td>\n    <td><b>BDN</b><br>(DIRECTOR - FINANCE)</td>\n    <td><b>SAM</b><br>(GM - Projects)</td>\n    <td><b>MTS</b><br>(CHIEF OPERATING OFFICER)</td>\n  </tr>\n  <tr>\n    <td style=\"width:14.28%; height:120px; vertical-align:top;\"></td>\n    <td style=\"width:14.28%; height:120px; vertical-align:top;\"></td>\n    <td style=\"width:14.28%; height:120px; vertical-align:top;\"></td>\n    <td style=\"width:14.28%; height:120px; vertical-align:top;\"></td>\n    <td style=\"width:14.28%; height:120px; vertical-align:top;\"></td>\n    <td style=\"width:14.28%; height:120px; vertical-align:top;\"></td>\n    <td style=\"width:14.28%; height:120px; vertical-align:top;\"></td>\n  </tr>\n</table>\n\n<table style=\"width: 100%; font-size: 10px; text-align: center;\" border=\"1\">\n  <tr>\n    <h5 class=\"c1\" style=\"text-align: center; padding:0px !important;\"><b>APPROVED BY</b></h5>\n  </tr>\n  <tr>\n    <td style=\"width:50%;\"><b>SB</b><br></td>\n    <td style=\"width:50%;\"><b>JMA</b><br></td>\n  </tr>\n  <tr>\n    <td style=\"height:100px;\">(MANAGING DIRECTOR & CEO)</td>\n    <td style=\"height:100px;\">(EMKAN HOLDING)</td>\n  </tr>\n</table>\n",
