 "font_size": 14,
 "html": "<div style=\"font-family: Arial, sans-serif; font-size: 12px;\">\n\n    <!-- Company Name -->\n    <h2 style=\"text-align: center; margin: 0;\">\n        {{ doc.company }}\n    </h2>\n\n    <!-- Form Title -->\n    <h3 style=\"text-align: center; margin: 0;\">\n        PAYMENT REQUEST FORM ({{ doc.name }})\n    </h3>\n    <br><br>\n\n    <!-- Date & Request No -->\n    <table style=\"width: 100%; font-size: 12px;\">\n        <tr>\n            <td><strong>DATE:</strong> {{ doc.transaction_date or \"\" }}</td>\n            <td style=\"text-align: right;\"><strong>Request No:</strong> {{ doc.name or \"\" }}</td>\n        </tr>\n    </table>\n    <br>\n\n    <!-- Supplier -->\n    <table style=\"width: 100%; font-size: 12px; display:flex;\">\n        <tr>\n            <td><strong>SUPPLIER</strong></td>\n            <td>{{ doc.party or \"\" }}</td>\n        </tr>\n        {% if doc.reference_name %}\n        <tr>\n            <td><strong>Payment Entry</strong></td>\n            <td>{{ doc.reference_name }}</td>\n        </tr>\n        {% endif %}\n    </table>\n\n    <br>\n\n    <!-- Invoice Table -->\n    <table style=\"width: 100%; border: 1px solid black; border-collapse: collapse; font-size: 12px;\">\n        <thead>\n            <tr style=\"background-color: #f0f0f0;\">\n                <th style=\"border: 1px solid black; padding: 5px;\">Reference Doctype</th>\n                <th style=\"border: 1px solid black; padding: 5px;\">Reference Name</th>\n                <th style=\"border: 1px solid black; padding: 5px; text-align: right;\">AMOUNT ({{ doc.currency or \"\" }})</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for row in doc.references %}\n            <tr>\n                <td style=\"border: 1px solid black; padding: 5px;\">{{ row.reference_doctype or \"\"}}</td>\n                <td style=\"border: 1px solid black; padding: 5px;\">{{ row.reference_name or \"\"}}</td>\n                <td style=\"border: 1px solid black; padding: 5px; text-align: right;\">{{ row.get_formatted(\"amount\") }} {{ doc.currency or \"\" }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    <br>\n\n    <!--<div style=\"text-align: left; font-size: 12px;\">-->\n    <!--    <em>(* Supportings attached for more reference)</em>-->\n    <!--</div>-->\n    <!--<br>-->\n\n    <!-- Total -->\n    <table style=\"width: 100%; font-size: 12px;\">\n        <tr>\n            <td style=\"text-align: right;\"><strong>TOTAL</strong></td>\n            <td style=\"text-align: right; width: 120px;\"><strong>{{ doc.get_formatted(\"grand_total\") }} {{ doc.currency or \"\" }}</strong></td>\n        </tr>\n    </table>\n    <br><br>\n\n    <!-- Signatures -->\n    <!--<table style=\"width: 100%; font-size: 12px; text-align: center;\">-->\n    <!--    <tr>-->\n    <!--        <td><strong>PREPARED BY</strong></td>-->\n    <!--        <td><strong>VERIFIED BY</strong></td>-->\n    <!--        <td><strong>RECOMMENDED BY</strong></td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td>{{ doc.prepared_by }}<br>(ASST. ACCOUNTANT)</td>-->\n    <!--        <td>{{ doc.verified_by }}<br>(SR. ACCOUNTANT)</td>-->\n    <!--        <td>{{ doc.recommended_by }}<br>(LEAD ACCOUNTANT)</td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td>{{ doc.manager_accounts }}<br>(MANAGER - ACCOUNTS)</td>-->\n    <!--        <td>{{ doc.director_finance }}<br>(DIRECTOR-FINANCE)</td>-->\n    <!--        <td>{{ doc.coo }}<br>(CHIEF OPERATING OFFICER)</td>-->\n    <!--    </tr>-->\n    <!--</table>-->\n    <!--<br><br>-->\n\n    <!-- Approval -->\n    <!--<table style=\"width: 100%; font-size: 12px; text-align: center;\">-->\n    <!--    <tr>-->\n    <!--        <td><strong>APPROVED BY</strong></td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td>{{ doc.md_ceo }}<br>(MANAGING DIRECTOR & CEO)</td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td>{{ doc.emkan_holding }}<br>(EMKAN HOLDING)</td>-->\n    <!--    </tr>-->\n    <!--</table>-->\n    <!--<br><br>-->\n\n    <!-- Bank Details -->\n    <!--<h4>BANK DETAILS</h4>-->\n    <!--<table style=\"width: 100%; font-size: 12px;\">-->\n    <!--    <tr>-->\n    <!--        <td><strong>ACCOUNT NAME:</strong></td>-->\n    <!--        <td>{{ doc.bank_account_name }}</td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td><strong>ACCOUNT NUMBER:</strong></td>-->\n    <!--        <td>{{ doc.bank_account_no }}</td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td><strong>BANK NAME:</strong></td>-->\n    <!--        <td>{{ doc.bank_name }}</td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td><strong>IBAN NUMBER:</strong></td>-->\n    <!--        <td>{{ doc.iban_number }}</td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td><strong>BRANCH:</strong></td>-->\n    <!--        <td>{{ doc.branch }}</td>-->\n    <!--    </tr>-->\n    <!--    <tr>-->\n    <!--        <td><strong>SWIFT CODE:</strong></td>-->\n    <!--        <td>{{ doc.swift_code }}</td>-->\n    <!--    </tr>-->\n    <!--</table>-->\n\n</div>\n",
