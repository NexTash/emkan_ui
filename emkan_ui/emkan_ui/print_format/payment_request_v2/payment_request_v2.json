 "css": "  @media print {\n    body {\n      margin: 0;\n      padding: 0;\n    }\n\n    .page-header {\n      margin: 0;\n      padding: 0;\n    }\n\n    .page-break {\n      page-break-before: always;\n    }\n\n    table {\n      border-collapse: collapse;\n      width: 100%;\n    }\n\n    th, td {\n      /*border: 1px solid black;*/\n      font-size: 12px;\n      padding: 6px;\n    }\n  }",
